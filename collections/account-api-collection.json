                  "// ASSUMPTION: 401 is expected for missing auth. Adjust if API returns 403.",
                  "const EXPECTED_UNAUTH_STATUS = 401;",
                  "",
                  "pm.test(\"[CONTRACT] Status is 401 when no auth token provided\", function () {",
                  "    pm.response.to.have.status(EXPECTED_UNAUTH_STATUS);",
                  "});",
                  "",
                  "pm.test(\"Response is not 500 Internal Server Error\", function () {",
                  "    pm.expect(pm.response.code).to.not.equal(500);",
                  "});",
                  "",
                  "pm.test(\"[SECURITY] Error response does not expose sensitive fields\", function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include(\"password\");",
                  "    pm.expect(text).to.not.include(\"api_token\");",
                  "});"
