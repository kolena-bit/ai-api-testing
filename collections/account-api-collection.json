    {
      "name": "PATCH /v1/account - Positive",
      "item": [
        {
          "name": "Update profile - all fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response has Content-Type application/json\", function () {\n    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\n});\n\npm.test(\"Response body is valid JSON\", function () {\n    pm.response.to.be.json;\n});\n\npm.test(\"[CONTRACT] Response has success: true\", function () {\n    const json = pm.response.json();\n    pm.expect(json).to.have.property(\"success\", true);\n});\n\npm.test(\"[CONTRACT] Response has data property\", function () {\n    const json = pm.response.json();\n    pm.expect(json).to.have.property(\"data\");\n});\n\npm.test(\"Response time is under 3000ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(3000);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"{{test_first_name}}\",\n  \"last_name\": \"{{test_last_name}}\",\n  \"phone\": \"{{test_phone}}\",\n  \"email\": \"{{test_email}}\",\n  \"lang\": \"{{test_lang}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/account",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "account"
              ]
            }
          },
          "response": []
        }
      ]
    },
